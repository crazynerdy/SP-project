# 复制本文件为 .env，填入实际值后即可运行（.env 不会入库）。
# 部署到服务器时建议改用专用服务账号，而非某个员工个人账号。

# iDSTE MCP Server
IDSTE_BASE=http://你的服务器:9090
IDSTE_USERNAME=
IDSTE_PASSWORD=
IDSTE_API_KEY=idste_mcp_

# 公司内网大模型（OpenAI 兼容）
LLM_BASE_URL=http://你的模型:port/v1
# 例：公司内网 <LLM地址>（VPN 内网，部署时填实际值）
LLM_MODEL=
LLM_API_KEY=sk-

# 战略规划输出格式模板路径（xlsx）
# 模板结构：DSTE 4 阶段 + BLM 6 模块 + 37 张 sheet（业绩差距/机会差距/市场洞察/战略意图/...）
# Agent 会按用户自然语言选 sheet 并填值，模板原样保留
TEMPLATE_XLSX_PATH=/path/to/your/template.xlsx

# SP 2026 智能体自动填写：驱动文件路径（gg Excel）
# GG_XLSX_PATH=D:\Desktop\gg\战略规划SP变更需求-6.5 版（产品需求沟通确认 2.0）.xlsx

# Qwen-Image 图片生成
QWEN_IMAGE_URL=http://<your-qwen-image-host>:<port>
QWEN_IMAGE_MODEL=Qwen-Image-2512
QWEN_IMAGE_TOKEN=<your-xsrf-token>
IMAGE_CACHE_DIR=cache/images
IMAGE_CACHE_MAX_MB=500

# 联网搜索
WEBSEARCH_ENABLED=true
WEBSEARCH_PROVIDER=duckduckgo
WEBSEARCH_MAX_RESULTS=5
WEBSEARCH_TIMEOUT=30
